# ============================================================================
# RiseTrader Staging Environment Variables
# ============================================================================

VERSION=1.0.0-staging
BUILD_DATE=2025-11-16
VCS_REF=develop

# Database
POSTGRES_DB=risetrader_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_password_2024

# Redis
REDIS_PASSWORD=staging_redis_2024

# API
HOST=0.0.0.0
PORT=8000
API_WORKERS=2
LOG_LEVEL=debug

# Security
JWT_SECRET_KEY=staging_jwt_secret_key_do_not_use_in_production
API_KEY=staging_api_key_12345

# CORS
CORS_ORIGINS=http://localhost:3000,https://staging.yourdomain.com

# MT4
MT4_HOST=75.154.254.174
MT4_COMMAND_PORT=5555
MT4_STREAM_PORT=5556
ZMQ_CLIENT_SECRET_KEY=staging_zmq_client_secret
ZMQ_CLIENT_PUBLIC_KEY=staging_zmq_client_public
ZMQ_SERVER_PUBLIC_KEY=staging_zmq_server_public

# Risk (reduced limits for staging)
MAX_POSITION_SIZE=1.0
MAX_DAILY_LOSS=100.0
MAX_OPEN_POSITIONS=2

# Features
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_FORECASTING=true

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging_grafana_2024

# Frontend
VITE_API_URL=https://staging.yourdomain.com/api
