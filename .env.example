# RiseTrader Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/risetrader
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=risetrader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# MT4 Integration (Feature: 001-mt4-integration)
# ============================================================================

# MT4 Server Connection
MT4_DEFAULT_HOST=75.154.254.186  # Your MT4 server IP/hostname
MT4_BASE_REP_PORT=5555           # Base port for command sockets (REQ/REP)
MT4_BASE_PUB_PORT=5556           # Base port for streaming sockets (PUB/SUB)

# CurveZMQ Encryption Keys (REQUIRED for production)
# Generate with: python scripts/generate_zmq_keys.py
ZMQ_CLIENT_SECRET_KEY=your_40_character_z85_encoded_client_secret_key_here
ZMQ_CLIENT_PUBLIC_KEY=your_40_character_z85_encoded_client_public_key_here
ZMQ_SERVER_PUBLIC_KEY=your_40_character_z85_encoded_server_public_key_here

# MT4 Connection Timeouts
ZMQ_COMMAND_TIMEOUT_MS=5000      # Command timeout (5 seconds)
ZMQ_QUERY_TIMEOUT_MS=10000       # Query timeout (10 seconds)
CONNECTION_HEALTH_CHECK_INTERVAL_SEC=30  # Heartbeat interval

# ============================================================================
# Security & Authentication
# ============================================================================
JWT_SECRET_KEY=your_jwt_secret_key_min_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

API_KEY=your_api_key_for_external_access
VALID_API_KEYS=key1,key2,key3  # Comma-separated list

# ============================================================================
# Feature Flags (Trading Safety)
# ============================================================================
ENABLE_LIVE_TRADING=false        # CRITICAL: Must be false until production-ready
ENABLE_PAPER_TRADING=true        # Safe for testing
ENABLE_BACKTESTING=true          # Enable backtest mode
ENABLE_FORECASTING=true          # Enable ML predictions

# ============================================================================
# Risk Management Limits
# ============================================================================
MAX_PORTFOLIO_MARGIN_PCT=80      # Maximum portfolio margin usage (80%)
MAX_SYMBOL_EXPOSURE=100000       # Maximum exposure per symbol ($100k)
MAX_DAILY_LOSS=5000              # Maximum daily loss limit ($5k)
MAX_OPEN_POSITIONS=50            # Maximum concurrent open positions
MAX_EA_COUNT=100                 # Maximum Expert Advisors per instance
MAX_POSITION_SIZE=10.0           # Maximum position size in lots

# ============================================================================
# Monitoring & Observability
# ============================================================================
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                  # json or text

# Prometheus
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Jaeger Tracing
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SERVICE_NAME=risetrader-mt4-integration

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development  # development, staging, production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# MLflow (Experiment Tracking)
# ============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=risetrader

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=RiseTrader
APP_VERSION=0.1.0
APP_ENV=development              # development, staging, production
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8003
API_WORKERS=4
API_RELOAD=true                  # Auto-reload on code changes (dev only)

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Email Notifications (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@risetrader.com

# Alert Recipients (comma-separated)
ALERT_EMAILS=admin@risetrader.com,trader@risetrader.com

# ============================================================================
# External APIs (Optional)
# ============================================================================

# Trading Economics API
TRADING_ECONOMICS_API_KEY=

# Alpha Vantage API
ALPHA_VANTAGE_API_KEY=

# ============================================================================
# Development & Testing
# ============================================================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/risetrader_test
PYTEST_ASYNCIO_MODE=auto

# Mock MT4 for Testing
MOCK_MT4_ENABLED=false           # Use mock MT4 EA for integration tests
MOCK_MT4_PORT=15555

# ============================================================================
# Performance Tuning
# ============================================================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

REDIS_MAX_CONNECTIONS=50

# ============================================================================
# Notes
# ============================================================================
# 1. Generate ZMQ keys: python scripts/generate_zmq_keys.py
# 2. Never commit .env file to git
# 3. Rotate keys every 90 days
# 4. Keep ENABLE_LIVE_TRADING=false until production validation complete
# 5. Test with ENABLE_PAPER_TRADING=true first
