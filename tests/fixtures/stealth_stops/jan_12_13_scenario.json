{
  "scenario_name": "jan_12_13_failure_scenario",
  "description": "Real scenario from January 12-13, 2026 where $600+ profit eroded to -$150 loss",
  "purpose": "SC-008: Validate that profits do not erode beyond -$100",

  "initial_conditions": {
    "position": {
      "ticket": 24494956,
      "symbol": "CrudeOIL",
      "direction": "short",
      "entry_price": 61.00,
      "lots": 1.0,
      "initial_stop": 0.0,
      "initial_tp": 58.00
    },
    "market": {
      "atr_14": 0.75,
      "spread": 0.03
    },
    "expected_disaster_stop": 63.25
  },

  "price_timeline": [
    {
      "timestamp": "2026-01-12T14:00:00Z",
      "price": 60.50,
      "profit_usd": 50.00,
      "event": "Initial profit",
      "expected_action": "disaster_stop_set",
      "expected_stop": 63.25
    },
    {
      "timestamp": "2026-01-12T15:00:00Z",
      "price": 60.25,
      "profit_usd": 75.00,
      "event": "Profit growing - reaches trail trigger (0.5× ATR = $0.375)",
      "expected_action": "trailing_activated",
      "notes": "With 0.5× ATR trigger, trailing starts at $0.375 profit instead of $0.75"
    },
    {
      "timestamp": "2026-01-12T16:00:00Z",
      "price": 59.50,
      "profit_usd": 150.00,
      "event": "Profit building",
      "expected_action": "trail_stop",
      "expected_stop": 60.63
    },
    {
      "timestamp": "2026-01-12T18:00:00Z",
      "price": 58.75,
      "profit_usd": 225.00,
      "event": "Strong profit",
      "expected_action": "trail_stop",
      "expected_stop": 59.88
    },
    {
      "timestamp": "2026-01-12T22:00:00Z",
      "price": 55.00,
      "profit_usd": 600.00,
      "event": "HIGHWATER MARK - Maximum profit reached",
      "expected_action": "set_highwater",
      "expected_highwater": 600.00,
      "expected_stop": 56.13
    },
    {
      "timestamp": "2026-01-13T02:00:00Z",
      "price": 55.75,
      "profit_usd": 525.00,
      "event": "Profit starting to erode",
      "erosion_usd": 75.00,
      "erosion_atr": 0.10,
      "expected_action": "monitor_erosion",
      "notes": "Erosion < 0.3× ATR, no action yet"
    },
    {
      "timestamp": "2026-01-13T04:00:00Z",
      "price": 56.50,
      "profit_usd": 450.00,
      "event": "Erosion continues",
      "erosion_usd": 150.00,
      "erosion_atr": 0.20,
      "expected_action": "monitor_erosion",
      "notes": "Erosion < 0.3× ATR, no action yet"
    },
    {
      "timestamp": "2026-01-13T06:00:00Z",
      "price": 57.25,
      "profit_usd": 375.00,
      "event": "Erosion exceeds alert threshold (0.3× ATR = $225)",
      "erosion_usd": 225.00,
      "erosion_atr": 0.30,
      "expected_action": "log_erosion_alert",
      "notes": "Alert logged, no stop tightening yet"
    },
    {
      "timestamp": "2026-01-13T08:00:00Z",
      "price": 58.00,
      "profit_usd": 300.00,
      "event": "Erosion approaches protection threshold",
      "erosion_usd": 300.00,
      "erosion_atr": 0.40,
      "expected_action": "monitor_erosion"
    },
    {
      "timestamp": "2026-01-13T10:00:00Z",
      "price": 58.50,
      "profit_usd": 250.00,
      "event": "CRITICAL: Erosion exceeds protection threshold (0.5× ATR = $375)",
      "erosion_usd": 350.00,
      "erosion_atr": 0.47,
      "expected_action": "tighten_stop",
      "expected_stop": 58.87,
      "notes": "Stop tightened to protect remaining profit"
    },
    {
      "timestamp": "2026-01-13T12:00:00Z",
      "price": 59.00,
      "profit_usd": 200.00,
      "event": "Further erosion with tightened stop",
      "erosion_usd": 400.00,
      "expected_action": "trail_stop",
      "notes": "Stop should be at 59.00 + 1.5×0.75 = 60.125"
    },
    {
      "timestamp": "2026-01-13T14:00:00Z",
      "price": 60.00,
      "profit_usd": 100.00,
      "event": "Approaching stop",
      "erosion_usd": 500.00,
      "expected_action": "position_protected",
      "notes": "With enhanced protection, stop should have been hit around $58.87"
    }
  ],

  "actual_outcome_without_protection": {
    "final_price": 61.50,
    "final_profit_usd": -50.00,
    "total_erosion_usd": 650.00,
    "notes": "In reality, profit eroded from $600 to -$50 (then manually closed)"
  },

  "expected_outcome_with_protection": {
    "stop_hit_price": 58.87,
    "protected_profit_usd": 213.00,
    "notes": "Stop should be hit at $58.87, locking in ~$213 profit"
  },

  "validation_criteria": {
    "SC-008": "Profit erosion must not exceed $100 from highwater",
    "minimum_protected_profit": 500.00,
    "maximum_allowed_erosion": 100.00
  }
}
