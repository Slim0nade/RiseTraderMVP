# RiseTrader RL Training Configuration Template
# Copy this file to rl_training_config.yaml and customize

rl_training:
  # Position Sizing Agent (SAC - continuous action)
  position_sizing:
    algorithm: "sac"
    hyperparameters:
      learning_rate: 0.0003
      gamma: 0.99
      batch_size: 256
      buffer_size: 1000000
      tau: 0.005
      train_freq: 1
      gradient_steps: 1

    reward_function:
      sharpe_weight: 0.6
      drawdown_weight: 0.3
      transaction_cost_penalty: 0.1

    validation:
      strategy: "walk_forward"
      train_days: 252
      test_days: 63
      step_days: 21
      min_sharpe_oos: 1.2  # Minimum out-of-sample Sharpe
      max_overfitting_score: 1.3  # train_sharpe / oos_sharpe

  # Stop Loss Agent (SAC - continuous action)
  stop_loss:
    algorithm: "sac"
    hyperparameters:
      learning_rate: 0.0003
      gamma: 0.95
      batch_size: 128
      buffer_size: 500000
      tau: 0.005

    reward_function:
      avoid_premature_stops_weight: 0.7
      minimize_loss_weight: 0.3

    validation:
      strategy: "walk_forward"
      train_days: 252
      test_days: 63
      step_days: 21
      min_sharpe_oos: 1.0

  # Take Profit Agent (SAC - continuous action)
  take_profit:
    algorithm: "sac"
    hyperparameters:
      learning_rate: 0.0003
      gamma: 0.95
      batch_size: 128
      buffer_size: 500000
      tau: 0.005

    reward_function:
      maximize_profit_weight: 0.6
      capture_moves_weight: 0.4

    validation:
      strategy: "walk_forward"
      train_days: 252
      test_days: 63
      step_days: 21
      min_sharpe_oos: 1.0

  # Trade Decision Agent (PPO - discrete action)
  trade_decision:
    algorithm: "ppo"
    hyperparameters:
      learning_rate: 0.0003
      gamma: 0.99
      n_steps: 2048
      batch_size: 64
      n_epochs: 10

    reward_function:
      pnl_weight: 0.5
      sharpe_weight: 0.3
      win_rate_weight: 0.2

    validation:
      strategy: "walk_forward"
      train_days: 252
      test_days: 63
      step_days: 21
      min_sharpe_oos: 1.0

# Global Training Settings
global_training:
  total_timesteps: 500000
  eval_freq: 10000
  save_freq: 25000
  verbose: 1
  seed: 42

# MLflow Tracking
mlflow:
  experiment_name: "rl_agent_training"
  tracking_uri: "http://localhost:5000"
  log_models: true
  log_artifacts: true
