# Simplified Dockerfile for RiseTrader API (without TA-Lib)
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libzmq5 \
    libopenblas-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir \
    -r requirements.txt \
    -r requirements-api.txt

# Copy application code
COPY src/ ./src/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY alembic.ini ./

# Set environment
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Copy and set executable startup script
COPY scripts/start_api.sh /app/start_api.sh
RUN chmod +x /app/start_api.sh

# Run startup script (supports hot reload via ENABLE_HOT_RELOAD env var)
# Use bash -c to ensure mounted scripts work even without +x bit
CMD ["bash", "/app/start_api.sh"]
