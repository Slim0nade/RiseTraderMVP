# ============================================================================
# RiseTrader Environment Variables Template
# Copy this file to .env and fill in your production values
# ============================================================================
# IMPORTANT: Never commit .env files with real credentials!
# ============================================================================

# ===========================================================================
# Build Information
# ===========================================================================
VERSION=1.0.0
BUILD_DATE=2025-11-16
VCS_REF=main

# ===========================================================================
# Database Configuration - PostgreSQL 17
# ===========================================================================
POSTGRES_DB=risetrader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# PostgreSQL Performance Tuning (adjust based on server specs)
# For 8GB RAM server:
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_WORK_MEM=64MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_MAX_CONNECTIONS=200

# Database Port (default: 5432, but using 5433 to avoid conflicts)
POSTGRES_PORT=5433

# ===========================================================================
# Redis Configuration
# ===========================================================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================================================
# API Configuration
# ===========================================================================
HOST=0.0.0.0
PORT=8000
API_PORT=8003
API_WORKERS=4
LOG_LEVEL=info
RELOAD=false

# ===========================================================================
# Security Configuration
# ===========================================================================
# Generate JWT secret with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# API Key for external integrations
API_KEY=CHANGE_ME_IN_PRODUCTION

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000
CORS_CREDENTIALS=true

# ===========================================================================
# MT4 Connection Configuration
# ===========================================================================
MT4_HOST=75.154.254.174
MT4_COMMAND_PORT=5555
MT4_STREAM_PORT=5556

# ZMQ CurveZMQ Encryption Keys
# Generate with: python -c "import zmq.auth; print(zmq.auth.create_certificates('.', 'client'))"
ZMQ_CLIENT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ZMQ_CLIENT_PUBLIC_KEY=CHANGE_ME_IN_PRODUCTION
ZMQ_SERVER_PUBLIC_KEY=CHANGE_ME_IN_PRODUCTION

# ===========================================================================
# Trading & Risk Management
# ===========================================================================
# Maximum position size in lots
MAX_POSITION_SIZE=10.0

# Maximum daily loss in USD
MAX_DAILY_LOSS=1000.0

# Maximum number of open positions
MAX_OPEN_POSITIONS=5

# Stop loss percentage (as decimal, e.g., 0.02 = 2%)
DEFAULT_STOP_LOSS=0.02

# Take profit percentage (as decimal, e.g., 0.03 = 3%)
DEFAULT_TAKE_PROFIT=0.03

# ===========================================================================
# Feature Flags
# ===========================================================================
# Enable paper trading mode (simulated trades)
ENABLE_PAPER_TRADING=true

# Enable live trading (DANGEROUS - set false until thoroughly tested)
ENABLE_LIVE_TRADING=false

# Enable ML forecasting
ENABLE_FORECASTING=true

# Enable automated trading
ENABLE_AUTO_TRADING=false

# ===========================================================================
# Monitoring Configuration
# ===========================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
GRAFANA_PORT=3001

# Elasticsearch, Logstash, Kibana (ELK Stack)
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
KIBANA_PORT=5601

# ===========================================================================
# MLflow Configuration
# ===========================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# ===========================================================================
# Frontend Configuration
# ===========================================================================
VITE_API_URL=http://localhost:8003/api

# Production URL
# VITE_API_URL=https://yourdomain.com/api

# ===========================================================================
# MCP Server Configuration (Agent Coordination)
# ===========================================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=7000
MCP_WEBSOCKET_PORT=7001

# ===========================================================================
# Logging Configuration
# ===========================================================================
LOG_FORMAT=json
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10

# ===========================================================================
# External Services (Optional)
# ===========================================================================
# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# Jaeger Distributed Tracing
# JAEGER_AGENT_HOST=jaeger
# JAEGER_AGENT_PORT=6831

# ===========================================================================
# Cloud Provider Configuration (Optional)
# ===========================================================================
# AWS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Google Cloud Platform
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1

# Digital Ocean
# DIGITALOCEAN_TOKEN=your-do-token
# DIGITALOCEAN_REGION=nyc3

# ===========================================================================
# Backup Configuration
# ===========================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=

# ===========================================================================
# Performance Tuning
# ===========================================================================
# Python optimizations
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Memory allocator tuning
MALLOC_TRIM_THRESHOLD_=100000
MALLOC_MMAP_THRESHOLD_=50000

# ML threading
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# ===========================================================================
# Development Settings (only for dev environment)
# ===========================================================================
# RELOAD=true
# LOG_LEVEL=debug
# API_WORKERS=1
